{
  "name": "perla-compute-vps",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack && node scripts/finalize-build.mjs",
    "start": "node scripts/start-vps.mjs",
    "db:migrate": "node scripts/migrate-vps.mjs",
    "check:mining": "node scripts/checks/mining.test.mjs",
    "check:vps": "node scripts/checks/vps.test.mjs",
    "check:rewards": "node scripts/checks/rewards.test.mjs",
    "check:api": "node scripts/checks/api.test.mjs",
    "rewards": "node scripts/perla-rewards.mjs",
    "package:mining": "node scripts/package-mining.mjs",
    "db:backup": "node scripts/backup-vps.mjs",
    "check:emission": "node scripts/checks/emission.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:source": "node scripts/checks/source-audit.mjs",
    "check": "npm run check:source && npm run check:vps && npm run check:rewards && npm run check:emission && npm run check:api && npm run check:portal && npm run check:policy && npm run check:operations",
    "check:portal": "node scripts/checks/portal.test.mjs",
    "check:rtx": "python3 services/rtx-worker/test_protocol.py",
    "check:operations": "python3 scripts/checks/operations_test.py",
    "check:policy": "node scripts/checks/policy.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@hookform/resolvers": "5.7.1",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "7.85.0",
    "react-resizable-panels": "4.12.2",
    "recharts": "3.8.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "1.1.2",
    "viem": "2.57.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "ganache": "7.9.2",
    "solc": "0.8.37",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "description": "GPU mining for AI compute with native proof verification and funded rewards on Robinhood.",
  "license": "MIT"
}
