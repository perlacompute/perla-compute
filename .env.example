# VPS web. Use HTTPS via Nginx for wallet signing.
PERLA_HTTP_PORT=3109
# Set this to your real HTTPS domain when configuring Nginx, no trailing path.
PERLA_PUBLIC_ORIGIN=
PORT=3109
HOSTNAME=127.0.0.1
PERLA_SQLITE_PATH=data/perla.sqlite

# Optional server-side inference activation. No live provider is configured by default.
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_MODEL_ID=
# Use at least 32 random characters. This is not an onchain private key.
PREPRODUCTION_ACCESS_TOKEN=

# Native mining: keep admission paused until GPU validation is complete.
PERLA_MINING_ENABLED=false
PERLA_VERIFIER_URL=
PERLA_VERIFIER_TOKEN=
PERLA_OPERATOR_TOKEN=
PERLA_REWARD_TOKEN=
PERLA_DISTRIBUTOR_ADDRESS=
PERLA_RPC_URL=https://rpc.testnet.chain.robinhood.com
